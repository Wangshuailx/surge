#!name=集英社ジャンプNAVI 免手机验证
#!desc=改写 /api/v1/account 与 /account/login 响应，把 is_need_verify 置 false，手机登录不再弹短信验证
#!category=改写

[Script]
jfnavi-noverify = type=http-response,pattern=^https://api\.jump-navi\.com/api/v1/account(/login)?($|\?),requires-body=1,script-path=https://raw.githubusercontent.com/Wangshuailx/surge/main/jfnavi_noverify.js,timeout=15

[MITM]
hostname = %APPEND% api.jump-navi.com
