#!name=ONE PIECE BASE 抓包修复
#!desc=补 current-server-time 响应头，修复 MITM 解密下 jp.co.bandainamcoent.BNEI0432 的启动闪退

[Script]
opb-fixtime = type=http-response,pattern=^https?:\/\/[^\/]*onepiece-base\.com\/,requires-body=0,script-path=https://raw.githubusercontent.com/Wangshuailx/surge/main/opb_fixtime.js,timeout=10

[MITM]
hostname = %APPEND% *.onepiece-base.com
