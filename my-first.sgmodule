#!name=我的第一个模块
#!desc=入门练习：拦截域名 / 伪造接口返回 / 脚本改响应 / 页面注入
#!category=测试

[Rule]
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT

[Map Local]
^https://httpbin\.org/get data-type=base64 data="PG1ldGEgY2hhcnNldD0idXRmLTgiPjxoMT5IZWxsbyBTdXJnZTwvaDE+PHA+6L+Z5Liq6aG16Z2i5piv5L2g55qE5qih5Z2X5Lyq6YCg55qEIPCfjok8L3A+PHA+6K+35rGC5qC55pys5rKh5Ye6572R44CCPC9wPg==" header="Content-Type:text/html" status-code=200

[Script]
打招呼 = type=http-response,pattern=^https://httpbin\.org/anything,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Wangshuailx/surge/main/hello.js,timeout=10

页面注入 = type=http-response,pattern=^https://httpbin\.org/html,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Wangshuailx/surge/main/inject.js,timeout=15

[MITM]
hostname = %APPEND% httpbin.org
